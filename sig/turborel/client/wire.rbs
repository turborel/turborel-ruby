module Turborel
  module Client
    # A connection's frames.
    module Wire
      @stream: Stream
      @lost: Error?
      @max_body: Integer
      @compress_from: Integer?
      @settings: Hash[String, String]
      @notices: Array[Protocol::Replies::Notice]
      @notice_handler: (^(Protocol::Replies::Notice) -> untyped)?
      @active: bool
      @warning: String?
      @commit_position: Integer?
      @completion: Protocol::Replies::Complete?
      @granted: Array[String]
      @query_attributes: Array[[String, String]]

      @copying: Copying?

      KEPT_NOTICES: Integer
      WHILE_COPYING: Array[Integer]
      WARNING_CLASS: String

      def self.ends_connection?: (Failure failure) -> bool

      private

      def send_frame: (String frames) -> void
      def written: (String frames) -> void
      def copying!: (String frames) -> void
      def expect: (*Class kinds, ?answer: Symbol) -> untyped
      def completion_reply: () -> Protocol::Replies::Complete
      def outcome: () -> [Rows | Protocol::Replies::Complete, bool]
      def rows_until_end: () -> [Array[Array[value]], Protocol::Replies::Complete?]
      def needs: (bool allowed, String name) -> void
      def carried_attributes: () -> Array[[String, String]]
      def receive: (?Symbol answer) -> Protocol::Replies::reply
      def took: (Protocol::Replies::reply reply) -> Protocol::Replies::reply?
      def notice: (Protocol::Replies::Notice notice) -> void
      def noted: (Protocol::Replies::reply reply) -> Protocol::Replies::reply
      def completed: (Protocol::Replies::Complete complete) -> void
      def next_reply: (?Symbol answer) -> Protocol::Replies::reply
      def next_frame: () -> [Integer, String]
      def skipped: (Integer kind, String body, Error error) -> void
      def drained: (Integer kind, String body) -> void
      def inflated: (String body) -> [Integer, String]
      def failed: (Failure failure) -> Error
      def lose: (String message) -> Error
      def lost_by: (Error error) -> Error
    end
  end
end
