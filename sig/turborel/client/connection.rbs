module Turborel
  module Client
    # A connection to a server.
    class Connection
      include Wire
      include Statements
      include Session
      include Lobs
      include Copy
      include Export
      include Pipelines

      @stream: Stream
      @target: Target?
      @timeouts: Timeouts?
      @max_body: Integer
      @granted: Array[String]
      @settings: Hash[String, String]
      @lost: Error?
      @key: String?
      @compress_from: Integer?
      @authorization: String
      @server: String
      @next_statement: Integer
      @active: bool
      @autocommit: bool
      @warning: String?
      @commit_position: Integer?
      @completion: Completion?
      @notices: Array[Notice]
      @events_kept: Array[Debug::Event]?
      @notice_handler: (^(Notice) -> untyped)?
      @query_attributes: Array[[String, String]]
      @copying: Copying?

      attr_reader authorization: String
      attr_reader server: String
      attr_reader granted: Array[String]
      attr_reader target: Target?
      attr_accessor max_body: Integer

      def self.open: (untyped io, user: String, mechanism: Mechanism, ?offer: Offer) -> Connection
      def self.open_within: (untyped io, user: String, mechanism: Mechanism, ?timeouts: Timeouts, ?offer: Offer) -> Connection
      def initialize: (Stream stream, Target? target, ?Timeouts? timeouts) -> void
      def log_in: (String user, Mechanism mechanism, Offer offer) -> void
      def read_timeout=: (seconds? seconds) -> void
      def read_timeout: () -> seconds?
      def granted?: (String name) -> bool
      def setting: (String name) -> String?
      def settings: () -> Hash[String, String]
      def lost?: () -> bool
      def canceller: () -> Canceller?
      def terminate: () -> void
      def abandon: () -> void
      def inspect: () -> String

      private

      def challenged: (Protocol::Replies::reply reply, Mechanism mechanism) -> void
      def ready: (Protocol::Replies::Ready reply, Mechanism mechanism, Offer offer) -> void
      def terminated: () -> void
    end
  end
end
