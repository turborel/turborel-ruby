module Turborel
  # A Ruby value the protocol carries.
  type value = nil | String | Integer | BigDecimal | Decimal | Float | bool | Array[value] | Datetime | Interval | DecFloat
             | Lob | Row | Multiset | Structured | Reference | Json | Xml | Uuid | Extension

  # A Ruby value of a JSON item.
  type json = nil | bool | Integer | BigDecimal | Decimal | Float | String | Symbol | DecFloat | Datetime | Array[json]
            | Hash[String | Symbol, json]

  # A date, a time or a timestamp.
  class Datetime < Data
    attr_reader moment: Symbol
    attr_reader utc: Integer
    attr_reader zone: Integer
    attr_reader zoned: bool
    attr_reader precision: Integer
    def self.new: (moment: Symbol, utc: Integer, zone: Integer, zoned: bool, precision: Integer) -> instance
  end

  # An interval.
  class Interval < Data
    attr_reader start: Symbol
    attr_reader finish: Symbol
    attr_reader leading: Integer
    attr_reader fraction: Integer
    attr_reader units: Integer
    def self.new: (start: Symbol, finish: Symbol, leading: Integer, fraction: Integer, units: Integer) -> instance
  end

  # An exact number keeping its scale.
  class Decimal < Data
    attr_reader units: Integer
    attr_reader scale: Integer
    def self.new: (units: Integer, scale: Integer) -> instance
    def to_d: () -> BigDecimal
    def to_s: () -> String
  end

  # A decimal floating point number.
  class DecFloat < Data
    attr_reader coefficient: Integer
    attr_reader exponent: Integer
    def self.new: (coefficient: Integer, exponent: Integer) -> instance
  end

  # A large object.
  class Lob < Data
    attr_reader kind: Symbol
    attr_reader data: String?
    attr_reader locator: Integer?
    attr_reader octets: Integer
    attr_reader characters: Integer?
    def self.new: (kind: Symbol, data: String?, locator: Integer?, octets: Integer, characters: Integer?) -> instance
  end

  # A row value.
  class Row < Data
    attr_reader values: Array[value]
    def self.new: (values: Array[value]) -> instance
  end

  # A multiset.
  class Multiset < Data
    attr_reader values: Array[value]
    def self.new: (values: Array[value]) -> instance
  end

  # A value of a structured type.
  class Structured < Data
    attr_reader schema: String
    attr_reader name: String
    attr_reader attributes: Array[value]
    def self.new: (schema: String, name: String, attributes: Array[value]) -> instance
  end

  # A reference.
  class Reference < Data
    attr_reader octets: String
    def self.new: (octets: String) -> instance
  end

  # A value of the JSON type.
  class Json < Data
    attr_reader value: json
    def self.new: (value: json) -> instance
  end

  # An XML value.
  class Xml < Data
    attr_reader text: String
    def self.new: (text: String) -> instance
    def nodes: () -> Array[XmlNodes::node]
  end

  # A UUID.
  class Uuid < Data
    GROUPS: Array[Integer]
    FORM: Regexp

    attr_reader octets: String
    def self.new: (octets: String) -> instance
    def self.parse: (String text) -> Uuid?
    def text: () -> String
  end

  # A value of a plug-in's type.
  class Extension < Data
    attr_reader name: String
    attr_reader text: String
    attr_reader bytes: String
    def self.new: (name: String, text: String, bytes: String) -> instance
  end

  # A data type.
  class DataType < Data
    attr_reader kind: Symbol
    attr_reader params: Hash[Symbol, untyped]
    def self.new: (kind: Symbol, params: Hash[Symbol, untyped]) -> instance
  end

  # A column of a result.
  class Column < Data
    attr_reader name: String?
    attr_reader type: DataType
    attr_reader not_null: bool
    attr_reader declared: Declared?
    def self.new: (name: String?, type: DataType, not_null: bool, ?declared: Declared?) -> instance
    def initialize: (name: String?, type: DataType, not_null: bool, ?declared: Declared?) -> void
    def with: (?name: String?, ?type: DataType, ?not_null: bool, ?declared: Declared?) -> Column
    def type_written: () -> String
    def type_name: () -> String
  end

  # The procedure a prepared CALL calls.
  class Called < Data
    attr_reader schema: String
    attr_reader name: String
    attr_reader parameters: Array[CalledParameter]
    def self.new: (schema: String, name: String, parameters: Array[CalledParameter]) -> instance
  end

  # A ? of a CALL.
  class CalledParameter < Data
    attr_reader mode: Symbol
    attr_reader ordinal: Integer
    attr_reader parameter: Parameter
    def self.new: (mode: Symbol, ordinal: Integer, parameter: Parameter) -> instance
  end

  # A column's declared type.
  class Declared < Data
    attr_reader name: String
    attr_reader written: String
    def self.new: (name: String, written: String) -> instance
  end

  # A dynamic parameter.
  class Parameter < Data
    attr_reader varying: bool
    attr_reader type: DataType
    def self.new: (varying: bool, type: DataType) -> instance
  end
end
